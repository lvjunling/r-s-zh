local EMBEDDED_JSON = [[{"version":1,"script_url":"https://raw.githubusercontent.com/EncryptedScripts/gakuran-heavy-assist/refs/heads/main/GakuranHeavyAssist.lua","translations":{"(not selected)":"（未选择）","+8 stud · target: nearest · your body stays still":"+8 格 · 目标：最近 · 本地角色保持原位","-":"-","01  ·  補助":"01  ·  辅助","100% = only counters that will land (rare whiff) · 0% = everything possible":"100% = 仅反击预计命中的攻击（很少打空） · 0% = 尝试所有可用反击","<b>Fling</b>: velocity / spin above the game's anti-fling lock (200 / 250 / 10).  <b>Reach</b>: server hitbox appears far from their body, or the body jumps to the target & back right as they hit.  <b>Desync</b>: body teleports & snaps back.  <b>Speed</b>: above the game's official limit for their height.  <b>Unauthorized sprint</b>: running 8 seconds without server permission.  <b>Jump</b>: jumping again before the 2-second cooldown / jumping too high.  <b>Fly</b>: floating without falling.  <b>Noclip</b>: passing through walls.  <b>Animation</b>: weight > 1, movement from another style, emote without server permission, animation the game doesn't own.":"<b>甩飞</b>：速度／旋转超过游戏防甩飞锁定阈值（200 / 250 / 10）。  <b>攻击延伸</b>：服务器判定框远离角色，或命中瞬间角色闪到目标旁后返回。  <b>不同步</b>：角色瞬移后回弹。  <b>速度</b>：超过该身高的官方速度上限。  <b>异常冲刺</b>：未获服务器许可却持续奔跑 8 秒。  <b>跳跃</b>：2 秒冷却结束前再次跳跃／跳得过高。  <b>飞行</b>：悬浮且不下落。  <b>穿墙</b>：穿过墙壁。  <b>动画</b>：权重大于 1、使用其他流派的移动动画、未获服务器许可播放表情，或使用非游戏所有的动画。","<font color=\"#F3EBDD\">automatic  (358 ms)</font>":"<font color=\"#F3EBDD\">自动  (358 毫秒)</font>","<font color=\"#F3EBDD\">automatic (follows ping)</font>":"<font color=\"#F3EBDD\">自动（跟随延迟）</font>","<font color=\"#F3EBDD\">default (0 stud)</font>":"<font color=\"#F3EBDD\">默认（0 格）</font>","<font color=\"#F3EBDD\">default (release after getting hit)</font>":"<font color=\"#F3EBDD\">默认（受击后松开）</font>","<font color=\"#F3EBDD\">solid</font>":"<font color=\"#F3EBDD\">实线</font>","<font color=\"#FF5A4F\"><b>WARNING:</b></font> Ultra Instinct is EXTREMELY obvious to everyone around you (you dodge almost every hit). <b>Do NOT use it on your main account</b>, it is for fun on alts only.":"<font color=\"#FF5A4F\"><b>警告：</b></font> 自在极意对周围所有人都极其显眼（几乎闪避每次攻击）。<b>请勿在主账号使用</b>，仅供小号娱乐。","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">+0.0</font>  STUD":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">+0.0</font>  格","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">+8</font>  STUD":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">+8</font>  格","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">0%</font>  (ALWAYS GREEN)":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">0%</font>  （始终绿色）","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">1.0</font>  X (GAME DEFAULT, ~6 STUD)":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">1.0</font>  倍（游戏默认，约 6 格）","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">1.5</font>  SEC":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">1.5</font>  秒","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">100%</font>  INCOMING ATTACKS":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">100%</font>  来袭攻击","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">100%</font>  OF ATTACKS":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">100%</font>  攻击比例","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">100%</font>  THAT ENTERS THE CIRCLE":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">100%</font>  进入圈内的目标","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">120</font>  MS":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">120</font>  毫秒","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">15%</font>  OF BOT ATTACKS":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">15%</font>  机器人攻击比例","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">200</font>  MS AFTER GETTING HIT":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">200</font>  受击后毫秒","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">200</font>  PX FROM CURSOR":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">200</font>  距光标像素","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">20</font>  SECONDS":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">20</font>  秒","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">360</font>  ° (ALL DIRECTIONS)":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">360</font>  °（全方向）","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">40%</font>  THAT CAN'T BE PARRIED":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">40%</font>  不可招架攻击","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">4</font>  SECONDS, THEN CONTINUE":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">4</font>  秒后继续","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">50%</font>  ·  BALANCED":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">50%</font>  ·  均衡","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">70</font>  MS AFTER WINDOW OPENS":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">70</font>  判定窗口开启后毫秒","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">80%</font>  ENEMY HEAVY":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">80%</font>  敌方重击","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">80</font>  STUD":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">80</font>  格","<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">95%</font>  ·  REST IS GOOD / OKAY":"<font face=\"Oswald\" weight=\"700\" size=\"19\" color=\"#F3EBDD\">95%</font>  ·  其余为良好／一般","ACCUSES BOT / CHEAT":"指责机器人／作弊","ADD RECORDING TO THIS PRESET (MERGE)":"将录制内容合并到此预设","AFK POSE":"挂机姿势","AFK pose":"挂机姿势","AGGRESSIVE 25%":"激进 25%","AI mode: fight effects (challenged / mercy / duel) still come from the local recognizer, AI only writes the sentence. Max 15 requests / minute, failed / too slow = local sentence. Key is not saved in config & never written to the log.":"AI 模式：战斗效果（挑战／求饶／决斗）仍由本地识别器决定，AI 只生成发言。每分钟最多 15 次请求，失败／超时则使用本地语句。密钥不保存到配置，也不写入日志。","AIM (CURSOR)":"瞄准（光标）","ALL":"全部","ALL DIFFICULTIES":"所有难度","ALL GAKURAN EMOTES  ·  CLICK = PLAY":"全部 GAKURAN 表情动作  ·  点击播放","ALL LENGTHS":"所有时长","ANIM":"动画","ANIMATION CHANGER":"动画替换","ANIMATION PACK":"动画套装","APT":"APT","AREA":"区域","ASKS ABOUT STYLE":"询问流派","ASKS FOR HELP":"求助","ASKS FOR TIPS":"请教技巧","ASKS HOW YOU ARE":"问候近况","ASKS WHO YOU ARE":"询问身份","ASKS WHO'S STRONGEST":"询问谁最强","ASSIST":"辅助","ATTACK & MOVEMENT":"攻击与移动","AUTO ACCEPT PIGGYBACK (TO BE CARRIED)":"自动接受背负邀请（被他人背起）","AUTO COUNTER SYSTEM":"自动反击系统","AUTO FIGHT":"自动战斗","AUTO LANGUAGE":"自动选择语言","AUTO PARRY":"自动招架","AUTO PARRY (INTERIUM)":"自动招架（INTERIUM）","AUTO PLAY MUSIC (AUTOMATIC SONGS)":"自动演奏（自动切换歌曲）","AUTO TAUNT":"自动嘲讽","AWP mode: hold an AWP, M1 / heavy = aim & shoot":"AWP 模式：持有 AWP，普攻／重击 = 瞄准并射击","Aikido":"合气道","Aim radius (Aim mode)":"瞄准半径（瞄准模式）","Ali":"Ali","All Attack":"全部攻击","Also allowed":"额外允许名单","Also counter NPC attacks (not just players)":"同时反击 NPC 攻击（不限玩家）","Also heavy (R)":"包含重击（R）","Also parry NPC attacks (not just players)":"同时招架 NPC 攻击（不限玩家）","Also parry enemy heavy (R)":"同时招架敌方重击（R）","Always green: release on the green zone":"始终绿色：在绿色区域松开","Arcade Clubroom":"街机社团活动室","Astrology Room":"占星教室","Auto Fight ON / OFF":"自动战斗 开／关","Auto Flow when the meter is full":"能量条满时自动激活 Flow","Auto Parry Interium ON / OFF":"Interium 自动招架 开／关","Auto Parry ON / OFF":"自动招架 开／关","Auto accept piggyback from allowed people":"自动接受允许名单内玩家的背负邀请","Auto aim: kick to the corner of the enemy goal":"自动瞄准：踢向敌方球门角落","Auto aim: spike to enemy side, pass to net":"自动瞄准：扣向敌方场地，传球朝向球网","Auto counter for Wing Chun / Aikido. R is pressed as the hit enters the window.":"咏春／合气道自动反击：攻击进入判定窗口时按 R","Auto dive when the ball heads to goal":"球飞向球门时自动扑救","Auto equip (T) when about to get hit":"即将受击时自动装备（T）","Auto monitor (always running, lightweight)":"自动监测（持续运行，轻量）","Auto music: follow other players":"自动演奏：跟随其他玩家","Auto parry / block range":"自动招架／格挡范围","Auto parry: NPCs":"自动招架：NPC","Auto parry: auto equip":"自动招架：自动装备","Auto parry: face attacker":"自动招架：面向攻击者","Auto parry: heavy too":"自动招架：包含重击","Auto parry: last moment":"自动招架：最后时刻补判","Auto parry: range ring":"自动招架：范围圈","Auto play music":"自动演奏","Auto play music: keeps playing random songs":"自动演奏：持续随机播放歌曲","Auto position between ball & goal":"自动站在球与球门之间","Auto receive: incoming ball = automatic bump":"自动接球：来球时自动垫球","Auto taunt":"自动嘲讽","Auto-fix stuck R":"自动修复 R 键卡住","Auto-fix stuck R (can't press R)":"自动修复 R 键卡住（R 键按不动）","Automatic pose when AFK (outside combat)":"挂机时自动摆姿势（非战斗状态）","Automatic taunt after you KO an enemy":"击倒敌人后自动嘲讽","Autoplay (guitar / bass / drums / keyboard)":"自动演奏（吉他／贝斯／鼓／键盘）","Autoplay instrument":"自动演奏乐器","B":"B","B A S I C":"基础","BACK TO PRE-TELEPORT POSITION":"返回传送前的位置","BALANCED 50%":"均衡 50%","BANCHO":"BANCHO","BASKET":"篮球","BEST-SELLING":"畅销","BOASTS":"自夸","BOT":"机器人","BOT DEFENSE & OFFENSE":"机器人防御与进攻","BRING PLAYER":"带来玩家","BRING RANDOM KNOCKED PLAYER":"带来随机倒地玩家","BRING: CARRY (KNOCKED PLAYER)":"带人：搬运（倒地玩家）","BRING: PIGGYBACK (FRIEND USING SCRIPT)":"带人：背负（同样运行脚本的好友）","BUILT-IN PRESETS":"内置预设","Backflip":"后空翻","Backflip Fail":"后空翻失败","Balenci":"Balenci","Basic":"基础","Basket always green":"篮球始终绿色","Basketball Court":"篮球场","Been Away":"Been Away","Being recorded":"正在录制","Big Guy":"Big Guy","Biology Laboratory":"生物实验室","Block":"格挡","Block hold duration (total)":"格挡持续时间（总计）","Board Game Clubroom":"桌游社团活动室","Boo":"嘘声","Bot resumes after you idle for":"闲置多久后机器人恢复行动","Boxing":"拳击","Brazil":"Brazil","Bring target":"带来目标","Bring: allow Roblox friends":"带人：允许 Roblox 好友","Bring: auto accept piggyback":"带人：自动接受背负邀请","Built-in brain, no recording needed & <b>can't be deleted</b>. Low → God: better parry, dodge, spacing & punishing an open opponent (after a parry / guard break / after attacking).":"内置行为模型，无需录制且<b>不可删除</b>。从低级到神级：招架、闪避、距离控制与抓破绽能力逐步增强（招架后／破防后／对手攻击后）。","C O M B A T":"战斗","C O U N T E R":"反击","CAMERA":"镜头","CASUAL PERSONA":"随和人设","CHAIN KILLER":"连环终结者","CHALLENGE":"挑战","CHAOS MIX":"混乱混合","CHAT BRAIN (REPLIES TO ENEMIES & TALKS ON ITS OWN)":"聊天行为模型（回复敌人并主动说话）","CHOSEN PLAYER":"已选玩家","CLEAR ALL EVIDENCE":"清除全部证据","CLEAR LOG":"清空日志","COCKY PERSONA":"自负人设","COMBAT":"战斗","COMPATIBILITY":"兼容性","CONFIG":"配置","COUNTER":"反击","COUNTER (WING CHUN / AIKIDO)":"反击（咏春／合气道）","COUNTER MODE":"反击模式","CQC":"近身格斗（CQC）","Cafeteria":"食堂","Calligraphy Classroom":"书法教室","Camera & body always face the target (uses Smoothing from Face Target). Default keybind Z = lock nearest / unlock.":"镜头与角色始终面向目标（使用“面向目标”的平滑设置）。默认快捷键 Z = 锁定最近目标／解除锁定。","Camera follows turn":"镜头跟随转向","Capoeira":"卡波耶拉","Chegou":"Chegou","Choose a type / sort order, or click SEARCH.":"选择类型／排序方式，或点击搜索。","Class 1-A":"1-A 教室","Class 1-D":"1-D 教室","Class 1-E":"1-E 教室","Class 3-A":"3-A 教室","Class 3-B":"3-B 教室","Class 3-C":"3-C 教室","Clee Vet Clinic":"Clee 兽医诊所","Click a location to teleport":"点击地点即可传送","Club Akuma":"Akuma 俱乐部","Club Akuma Stage":"Akuma 俱乐部舞台","Config name...":"配置名称…","Config:  (choose)":"配置： （请选择）","Copy Cat":"Copy Cat","Cortisol":"Cortisol","Counter":"反击","Counter (auto counter system)":"反击（自动反击系统）","Counter 0  ·  Whiff 0  ·  Rejected 0 (server 0)  ·  M1 held 0  ·  Last: -":"反击 0  ·  打空 0  ·  被拒绝 0（服务器 0）  ·  暂停普攻 0  ·  上次：-","Counter NPCs":"反击 NPC","Counter is off. Pick a mode or press its key.":"反击已关闭。请选择模式或按对应快捷键。","Counter priority":"反击优先","Counter priority: hold M1 in close duels":"反击优先：近距离交战时暂停普攻","Counter: dynamic range":"反击：动态范围","Counter: range circle":"反击：范围圈","Courtyard":"庭院","Crazy":"Crazy","DEBUG":"调试","DEEPSEEK AI":"DEEPSEEK AI","DELETE":"删除","DELETE KEY":"删除密钥","DELETE SELECTED PRESET":"删除所选预设","DISPLAY":"显示","DODGE (DASH)":"闪避（冲刺）","DON'T FIGHT THEM":"不与这些目标交战","Dance":"跳舞","Dante's Yakiniku":"Dante 烤肉店","Dash":"冲刺","Dash power (Q dash distance)":"冲刺力度（Q 冲刺距离）","Dead = request respawn from the server right away (no need to click 7x). Auto respawns: 0":"死亡后立即向服务器请求重生（无需点击 7 次）。自动重生次数：0","Debug log":"调试日志","Debug log (decision for every attack)":"调试日志（记录每次攻击的决策）","DeepSeek API Key":"DeepSeek API 密钥","Dodge = dash when the enemy's heavy hits (normal block vs heavy = guard break) / an attack that can't be parried, block is on cooldown, or stamina is low. Press a key / click = you're in control, release = bot resumes.":"闪避 = 敌方重击命中时冲刺（普通格挡遇到重击会破防），或在攻击不可招架、格挡冷却、体力不足时冲刺。按键／点击 = 接管控制；松开 = 机器人恢复行动。","Dodge chance":"闪避概率","Dodge everything (M1 combos too, fake dodge on cooldown)":"闪避所有攻击（含普攻连招，冷却时模拟闪避）","Dodge heavy (my config)":"闪避重击（我的配置）","Dodge in place (go back to your spot)":"原地闪避（返回原位置）","Dodge regular hits (my config)":"闪避普通攻击（我的配置）","Dojo Room":"道场","Doodle":"Doodle","Dragon":"龙","Dynamic range (follows enemy movement)":"动态范围（跟随敌人移动）","EASY":"简单","EMERALD":"翡翠","EMOTE":"表情动作","EMOTE — VISIBLE TO EVERYONE":"表情动作 — 所有玩家可见","ENEMY ESP":"敌人透视","ENGLISH":"英语","ESP range":"透视范围","EXPLOITER SCANNER":"异常行为扫描","EXTREME":"极限","Each section can <b>follow the preset</b> (recording / built-in level) or <b>your config</b>. Parry timing always uses the main auto parry system, counter uses the main auto counter zone & circle.":"每个部分均可<b>跟随预设</b>（录制／内置等级）或使用<b>你的配置</b>。招架时机始终沿用主自动招架系统，反击沿用主自动反击区域与范围圈。","Emote slot 1 (play / stop)":"表情槽位 1（播放／停止）","Emote slot 2 (play / stop)":"表情槽位 2（播放／停止）","Emote slot 3 (play / stop)":"表情槽位 3（播放／停止）","Emote slot 4 (play / stop)":"表情槽位 4（播放／停止）","Emote while walking":"移动时播放表情","Emote while walking (doesn't cancel when moving)":"移动时播放表情（移动不取消）","Emotes play directly on your character → <b>all players see it</b>. Works anywhere: combat stance, in the air, right after attacking. <b>Backflip</b> = its VFX shows on everyone's screen. Moving / jumping / getting hit = emote stops.":"表情直接在角色身上播放 → <b>所有玩家可见</b>。战斗姿态、空中或刚攻击后均可播放。<b>后空翻</b>的特效会显示在所有人的屏幕上。移动／跳跃／受击会停止表情。","Enemy goal determined by your team (casual play: whichever goal faces your camera), the corner farthest from the keeper. Kick height is calculated by the server.\nKicks 0  ·  held for full power 0  ·  keeper dives 0":"根据队伍判断敌方球门（休闲模式使用镜头朝向的球门），瞄准离守门员最远的角落。踢球高度由服务器计算。\n踢球 0 次  ·  蓄满力 0 次  ·  守门扑救 0 次","Enemy nameplate":"敌人信息牌","Enemy nameplate: name, HP, stamina, heavy":"敌人信息牌：名字、生命、体力、重击","Evernight":"Evernight","Example: \"1v1 gw kalo berani\", \"lu bot ya\", \"ampun bang\", \"gg wp\", \"who are you\".":"示例：“敢不敢跟我单挑”“你是机器人吗”“大哥饶命”“打得不错”“你是谁”。","Exploiter scanner flag on nameplate":"在信息牌显示异常扫描标记","FACE ON TARGET":"面向目标","FACE TARGET":"面向目标","FEATURE KEYBINDS (ON / OFF)":"功能快捷键（开／关）","FIGHT GAKURAN NPCS (STUDENTS WHO CAN FIGHT)":"与 GAKURAN NPC 交战（可战斗的学生）","FLIRTS":"调情","FOLLOW PRESET":"跟随预设","FOLLOW PRESET PATTERN":"跟随预设模式","FPS & PING":"帧率与延迟","FPS & ping":"帧率与延迟","FULL PARRY  100%":"全招架  100%","FULL SET FROM ONE STYLE":"使用同一流派的整套动画","FUN":"娱乐","Face Target ON / OFF":"面向目标 开／关","Face attackers from the side / behind":"面向侧后方的攻击者","Face: camera follows":"朝向：镜头跟随","Fall":"下落","Fast mode (stop once your hitbox appears)":"快速模式（判定框出现后停止）","Fast mode: hold after hitbox":"快速模式：判定框出现后的维持时间","Fein":"Fein","Final boss: harder at 50% / 25% HP":"最终首领：生命低于 50%／25% 时增强","Firework":"烟花","Fling (target launched far out of the map)":"甩飞（将目标远远弹出地图）","Follow other players' songs in the area (no clashing)":"跟随区域内其他玩家的歌曲（避免冲突）","Full Parry · 100% · every attack, timing as close as possible":"全招架 · 100% · 每次攻击均尽量贴近判定时机","Full power: release anytime, kick waits for 100 power":"满力：随时松开，等力量达到 100 后踢球","G A K U R A N   S U I T E":"GAKURAN 套件","GAKUMART":"GAKUMART 商店","GAME DISPLAY":"游戏显示","GET":"获取","GG":"打得不错（GG）","GOALKEEPER (BECOME KEEPER: PRESS G IN THE PENALTY BOX)":"守门员（在禁区内按 G 成为守门员）","GOD LEVEL":"神级","GOT IT WRONG? CLICK THE RIGHT INTENT (NPC LEARNS)":"判断错误？点击正确意图（NPC 会学习）","GREET":"问候","GRIP KNOCKED OPPONENTS (B)":"终结倒地对手（B）","Gambler":"Gambler","Gardening":"园艺","Giovanna":"Giovanna","Griddy":"Griddy","Guard zone: stay out of armed players' reach (server side)":"防护区域：避开持械玩家的攻击范围（服务器侧）","HARD":"困难","HEAVY":"重击","HEAVY (R)":"重击（R）","HIDE":"隐藏","HUD: HP, stamina, heavy cooldown (bottom of screen)":"状态栏：生命、体力、重击冷却（屏幕底部）","Hakari":"Hakari","Hakari Other":"Hakari Other","Hallway F-1":"一楼走廊","Hallway F-2":"二楼走廊","Hallway F-3":"三楼走廊","Heavy (R)":"重击（R）","Heavy (my config)":"重击（我的配置）","Heavy Attack Only":"仅重击","Heavy Love":"Heavy Love","Hide / Show UI":"隐藏／显示界面","Hide IN COMBAT":"隐藏战斗状态文字","Hide the game's \"IN COMBAT\" text":"隐藏游戏的“战斗中”文字","Highlight reach target (+ aim circle)":"高亮延伸攻击目标（含瞄准圈）","Hikaken":"Hikaken","Hit certainty":"命中把握","Hold block":"持续格挡","Hold your swing when a hit is incoming (can't dodge mid-swing)":"即将受击时暂缓出招（挥击过程中不可闪避）","Honey":"Honey","How often it talks during fights":"战斗中发言频率","Hyoga":"Hyoga","Hype Man":"Hype Man","INDONESIAN":"印度尼西亚语","INSANE":"疯狂","INSULT":"辱骂","IRON FIST":"铁拳","Idle (relaxed)":"待机（放松）","Idle combat":"战斗待机","Idle, walk, run, jump, fall, land & dash — <b>visible to other players</b>. Can use Gakuran animations (stance / other walk style, pose, dance) or marketplace animation packs (Emote tab).":"待机、行走、奔跑、跳跃、下落、落地和冲刺——<b>其他玩家可见</b>。可使用 Gakuran 动画（姿态／其他行走流派、摆姿势、舞蹈）或市场动画套装（表情页）。","Indoor Gymnasium":"室内体育馆","Infirmary":"医务室","Instant respawn":"立即重生","Instant respawn (skip the heart click)":"立即重生（跳过点击爱心）","Instructions":"使用说明","Interium not detected":"未检测到 Interium","J":"J","Jamal Dance":"Jamal Dance","Jason":"Jason","Jet Set":"Jet Set","Jin":"Jin","Judo":"柔道","Jump":"跳跃","Jumpstyle":"Jumpstyle","K":"K","KEYBIND":"快捷键","KICK MASTER":"踢技大师","KNOCK SCANNER (ALL KNOCKED ON SERVER)":"倒地扫描（服务器内全部倒地玩家）","Karaoke Center":"卡拉 OK 中心","Karate":"空手道","Key for slot 1 (play / stop)":"槽位 1 快捷键（播放／停止）","Key for slot 2 (play / stop)":"槽位 2 快捷键（播放／停止）","Key for slot 3 (play / stop)":"槽位 3 快捷键（播放／停止）","Key for slot 4 (play / stop)":"槽位 4 快捷键（播放／停止）","Kickboxing":"踢拳","Koto":"Koto","Kure":"Kure","Kyokushin":"极真空手道","L":"L","LAUGH":"大笑","LIKE HUMAN  70%":"拟人  70%","LOAD":"加载","LOAD MORE":"加载更多","LOCAL (ML, FREE)":"本地（机器学习，免费）","LOCK":"锁定","LOCK NEAREST":"锁定最近目标","LOCK TARGET":"锁定目标","LONG > 4M":"长曲 > 4 分钟","LOW LEVEL":"低级","Label":"标签","Land":"落地","Last-moment backup (hitbox already touching)":"最后一刻补判（判定框已接触）","Lethwei":"缅甸拳","Lock Target (nearest / unlock)":"锁定目标（最近／解除）","Lonely":"Lonely","Lounge":"休息室","M1":"M1","M1 #1":"普攻 #1","M1 #2":"普攻 #2","M1 #3":"普攻 #3","M1 #4 (finisher)":"普攻 #4（终结技）","M1 Guard":"普攻保护","M1 Guard: hold your M1 when the enemy is about to hit":"普攻保护：敌人即将命中时暂停出招","M1 swing speed is set by the server from your height (verified live: holding M1 = swings connect with zero gap at all). No Delay only matters if you CLICK-CLICK: clicking mid-swing isn't wasted, it connects immediately just like holding. If you hold M1, the result is exactly the same.":"普攻挥击速度由服务器根据身高决定（实时验证：持续按住普攻时，攻击之间没有间隙）。“无间隔”仅对连续点击有效：挥击中点击不会被浪费，会像按住一样立即衔接。若始终按住普攻，效果完全相同。","MEDIUM":"中等","MEDIUM 2.5-4M":"中等时长 2.5–4 分钟","MID LEVEL":"中级","MODE":"模式","MOVEMENT OUTSIDE COMBAT":"非战斗移动","MUAY THAI KILLER":"泰拳终结者","MUSICAL INSTRUMENTS (RHYTHM)":"乐器（节奏）","MY CONFIG":"我的配置","Manga Shop":"漫画店","Men's Restroom (2F)":"男洗手间（二楼）","Menu transparency":"菜单透明度","Mishima":"三岛","Miss percentage (to look natural)":"失误比例（表现更自然）","Mode NPC ON / OFF":"NPC 模式 开／关","Mode change notification":"模式切换通知","Monster":"Monster","Movement prediction correction":"移动预测修正","Muay Thai":"泰拳","Music Room":"音乐室","Music Store":"乐器店","Must be equipped (T). Counter Wing Chun ready = attack handed off to counter. M1 Guard (Assist tab) holds your swing when it's about to be parried.":"必须先装备（T）。咏春反击就绪时将攻击交给反击系统。“辅助”页的普攻保护会在即将被招架时暂停出招。","Myself":"自己","NEAREST":"最近","NEAREST OPPONENT":"最近的对手","NEWEST":"最新","NISHIKATA HIGH ROOMS":"西片高中房间","NO / DECLINES":"否／拒绝","NO GRIP":"不终结倒地者","NPC":"NPC","NPC & PLAYERS":"NPC 与玩家","NPC + PLAYERS":"NPC + 玩家","NPC MODE":"NPC 模式","NPC MODE (FINAL BOSS)":"NPC 模式（最终首领）","NPC Name":"NPC 名字","NPC ONLY":"仅 NPC","NPCs follow the target mode above (nearest / whoever attacks first). NPC attacks also get parried / countered / dodged. An opponent you just knocked gets approached & gripped (B), then you move on to the next one.":"NPC 遵循上方目标模式（最近／优先攻击者），其攻击也会被招架／反击／闪避。刚被击倒的对手会被靠近并终结（B），然后转向下一个目标。","Never MISSes. Piano free mode isn't a rhythm game.\nBasket: 0 shots (0 intentional misses)  ·  Music: 0 notes (0 PERFECT)":"不会出现 MISS。钢琴自由模式不是节奏游戏。\n篮球：投篮 0 次（主动失误 0 次）  ·  演奏：音符 0 个（PERFECT 0 个）","Nishikata District":"西片街区","Nishikata High":"西片高中","Nishikata High Entrance":"西片高中入口","No Delay (click)":"无间隔（点击）","No Delay: click mid-swing to chain":"无间隔：挥击中点击以衔接连击","No Slowdown":"移除减速","No Slowdown: not slowed while attacking / blocking":"移除减速：攻击／格挡时不减速","No Stun Slow":"移除受击减速","No Stun Slow: keep walking speed while in hitstun":"移除受击减速：受击硬直时保持移速","No recorded presets yet":"暂无录制预设","Normal Attack Only":"仅普通攻击","Notify on mode change when UI is hidden":"界面隐藏时显示模式切换通知","Nya":"Nya","Nyanmelo Cafe":"Nyanmelo Cafe","OCEAN":"海洋","OFF":"关闭","ON":"开启","OTHER AUTO PARRY HUB (INTERIUM)":"其他自动招架脚本（INTERIUM）","One line per note: <b>keyword, keyword = reply | reply</b>. Mentioned in chat = Local mode replies with your line, AI mode uses this as an opinion. {kalah} = how many times that person lost to you. Click outside the box = saved.":"每行一条备注：<b>关键词, 关键词 = 回复 | 回复</b>。聊天中提及关键词时，本地模式使用你的语句回复，AI 模式将其视为观点。{kalah} = 此人输给你的次数。点击输入框外保存。","Only flags <b>hard evidence</b>: events that are impossible without a script (breaking physics / rules the game itself enforces). Auto parry, fast reactions & hit range are <b>not counted</b>: skilled players & tall characters look identical. ESP, aimlock, auto parry & UI hubs leave no trace and can't be detected from any client.":"仅标记<b>明确证据</b>：需要脚本才能触发的事件（违反物理／游戏自身强制规则）。自动招架、快速反应与攻击距离<b>不计入</b>：高手和高个角色表现相似。原脚本说明称：透视、锁定瞄准、自动招架与界面脚本不留痕迹，任意客户端均检测不到。","Only players within this range, max 8 closest (kept light). Enemy stamina is an estimate: the server only sends stamina to its owner, so it's calculated from sprinting, stamina loss from blocked hits & guard breaks.":"仅监测此范围内最近的最多 8 名玩家（减轻负担）。敌人体力为估算：服务器只向体力所属玩家发送数值，因此根据冲刺、格挡受击和破防损耗计算。","Or paste marketplace ID / link...":"或粘贴市场 ID／链接…","Original":"原始","Other":"其他","Otsukare":"Otsukare","P":"P","PANDA HUB":"PANDA HUB","PARRY":"招架","PEOPLE & GROUP NOTES (USED BY NPC)":"人物与群体备注（供 NPC 使用）","PER MOVE":"按动作设置","PERFECT PARRY":"完美招架","PERFECT percentage":"PERFECT 判定比例","PLAYER":"玩家","POPULAR":"热门","PRAISE":"赞扬","PRESET MIX":"预设混合","PRO  90%":"专业  90%","PRO LEVEL":"专业级","Palm Tree":"Palm Tree","Paqueta":"Paqueta","Parking Lot":"停车场","Parry (my config)":"招架（我的配置）","Parry chance (Custom)":"招架概率（自定义）","Parry timing":"招架时机","Pause other auto parry hub when counter is ready":"反击就绪时暂停其他自动招架脚本","Pause other parry hub":"暂停其他招架脚本","Perfect Copy":"Perfect Copy","Pick a target, then: <b>Piggyback</b> = TP to them, piggyback emote, they accept, TP back, release (only works on friends who also run this script & turn on <b>Auto Accept</b> for you; other players can't be forced to accept). <b>Carry</b> = for someone who's knocked (game's built-in V), no need for them to accept.":"选择目标后：<b>背负</b> = 传送过去，播放背负表情，对方接受，传回原位并放下（仅适用于同样运行此脚本且为你开启<b>自动接受</b>的好友；其他玩家需自行接受）。<b>搬运</b> = 适用于倒地玩家（游戏内置 V 键），无需对方接受。","Pose":"姿势","Predicted hitbox":"预测判定框","Preset name (e.g. My Style, Renz's Style)...":"预设名称（例如：我的流派、Renz 的流派）…","Press E like normal, release anytime / hold it — the script releases it on green. Whether it goes in still depends on distance & being guarded.":"照常按 E，随时松开或持续按住均可——脚本会在绿色区域释放。是否进球仍取决于距离和防守。","Press a mode key = ON, press again = OFF (one mode active at a time). Click the box to change a key — Backspace clears it, Esc cancels. Game keys can be reused (e.g. F: block + toggle at once). Keybinds for every other feature are below.":"按模式快捷键开启，再按一次关闭（同时仅启用一个模式）。点击按键框修改——Backspace 清除，Esc 取消。可复用游戏按键（例如 F 同时格挡并切换）。其他功能快捷键在下方。","Principal Office":"校长办公室","Pro":"专业","R READY":"R 已就绪","R T T   ( M S )":"往返延迟（毫秒）","REACH":"攻击距离延伸","RECORD FIGHTING STYLE":"录制战斗风格","RECORDED PRESET":"录制预设","RELAXED  45%":"轻松  45%","RELEVANT":"相关度","RESET ALL (ORIGINAL ANIMATIONS)":"重置全部（原始动画）","RESET FPS & PING POSITION":"重置帧率与延迟组件位置","RESET MOVEMENT (ORIGINAL ANIMATION)":"重置移动（原始动画）","RESPAWN":"重生","RIGHTSHIFT":"右 Shift 键","ROBLOX MARKETPLACE  ·  EMOTE & ANIMATION PACK":"ROBLOX 市场  ·  表情与动画套装","Range bonus":"范围加成","Rat":"Rat","Reach ON / OFF":"攻击延伸 开／关","Reach range":"攻击延伸范围","Reach: AWP mode":"攻击延伸：AWP 模式","Reach: fast mode":"攻击延伸：快速模式","Reach: fling target":"攻击延伸：甩飞目标","Reach: heavy too":"攻击延伸：包含重击","Reach: highlight target":"攻击延伸：高亮目标","Reach: unlimited":"攻击延伸：不限距离","Rebahan Sleepy":"Rebahan Sleepy","Record someone who's <b>fighting</b> (yourself / another player on the server). The longer & more opponents, the closer the bot matches. Recorded: spacing, movement, combos, heavy, dash, parry, counter, plus <b>the outcome</b> (attacks that land get used more often).":"录制正在<b>战斗</b>的玩家（自己／服务器内其他玩家）。录制越久、对手越多，机器人越接近其风格。记录距离控制、移动、连招、重击、冲刺、招架、反击以及<b>结果</b>（命中过的攻击更常被采用）。","Rejoin within 5 minutes -> continues the last session's settings. Fresh join: if AUTOLOAD is set -> exactly that config (settings not saved in it won't carry over). No autoload / the toggle above ON -> last session's settings. Loading a config = exactly the file's contents; settings missing from it revert to default.":"5 分钟内重进游戏 → 继续上次会话设置。全新进入时：若设置自动加载 → 严格使用该配置（其中未保存的设置不继承）。未设自动加载／上方开关开启 → 使用上次会话设置。加载配置时严格采用文件内容，缺失设置恢复默认。","Rejoin: continue the last session (even if not saved)":"重进游戏：继续上次会话（即使未保存）","Reply to nearby chat":"回复附近聊天","Results screen shown for":"结果界面显示时长","Reze":"Reze","RightShift = hide / show UI (fully disappears)\nMinus button in the header = hide  ·  X button = unload (all features off)":"右 Shift = 隐藏／显示界面（完全隐藏）\n标题栏减号 = 隐藏  ·  X 按钮 = 卸载（关闭全部功能）","Roam & chat when not fighting (needs Auto Fight)":"非战斗时闲逛聊天（需要自动战斗）","Rooftop":"屋顶","Rotation cone":"转向锥角","Run (sprint)":"奔跑（冲刺）","Ryu":"Ryu","S Y S T E M":"系统","SAD":"悲伤","SAFE":"保守","SAKURA":"樱花","SAVE":"保存","SAVE RECORDING AS NEW PRESET":"将录制内容保存为新预设","SAYS BYE":"告别","SCAN":"扫描","SCRIPT":"脚本","SEARCH":"搜索","SELECTED PLAYER":"所选玩家","SET":"设置","SET AUTOLOAD":"设置自动加载","SETTINGS":"设置","SHORT < 2.5M":"短曲 < 2.5 分钟","SNIPER FX (REACH)":"狙击特效（攻击延伸）","SOCCER":"足球","SPEEDSTER":"速度型","START RECORDING":"开始录制","STATUS":"状态","STOP EMOTE":"停止表情动作","STREET BRAWLER":"街头斗士","STRICT 75%":"严格 75%","SUNSET":"日落","SURRENDER":"投降","Saved in the executor folder: EncryptedHeavyAssist/configs":"保存在执行器目录：EncryptedHeavyAssist/configs","Scanner flag on nameplate":"在信息牌显示扫描标记","Scanner: auto monitor":"扫描器：自动监测","Scarecrow":"Scarecrow","Search animations (all categories)...":"搜索动画（全部类别）…","Search emote (all categories)...":"搜索表情（全部类别）…","Search emote / pack (empty = all)...":"搜索表情／套装（留空 = 全部）…","Search player (Gakuran name / username)...":"搜索玩家（Gakuran 名字／用户名）…","Search players (Gakuran name / username)...":"搜索玩家（Gakuran 名字／用户名）…","Search styles...":"搜索流派…","Searched <b>live</b> from the Roblox marketplace (always up to date, can sort by newest). Animation pack → idle, walk, run, jump, fall. Emote → slot, taunt, AFK, parry, idle. All <b>visible to other players</b>.":"从 Roblox 市场<b>实时</b>搜索（保持更新，可按最新排序）。动画套装 → 待机、行走、奔跑、跳跃、下落。表情 → 槽位、嘲讽、挂机、招架、待机。全部<b>对其他玩家可见</b>。","Secondary Music Room":"第二音乐室","Senbonzakura":"Senbonzakura","Shoot":"射门","Show FPS & ping (drag the widget to move it)":"显示帧率与延迟（拖动组件调整位置）","Show auto parry range ring (blue)":"显示自动招架范围圈（蓝色）","Show predicted hitbox (green / red)":"显示预测判定框（绿色／红色）","Show range circle on the ground":"在地面显示范围圈","Show scan result marker on ESP nameplate":"在透视信息牌上显示扫描结果标记","Shuffle":"Shuffle","Six Seven":"Six Seven","Skatepark":"滑板公园","Slot 1":"槽位 1","Slot 2":"槽位 2","Slot 3":"槽位 3","Slot 4":"槽位 4","Slow Clap":"慢速鼓掌","Slugger":"Slugger","Smoke (missing)":"烟雾（缺失）","Smoothing":"平滑度","Sniper sound: shot & hit (only you)":"狙击音效：开枪与命中（仅自己可听）","Sniper visual: tracer, scope & hitmarker (only you)":"狙击视觉：弹道、瞄准镜与命中标记（仅自己可见）","Soccer Field":"足球场","Soccer: auto Flow":"足球：自动 Flow","Soccer: auto aim goal":"足球：自动瞄准球门","Soccer: auto keeper":"足球：自动守门","Soccer: full power":"足球：满力射门","Soccer: keeper position":"足球：守门站位","Spike with maximum power":"最大力度扣球","Stars":"Stars","Start hidden (show with the Hide / Show UI key)":"启动时隐藏（用隐藏／显示界面快捷键打开）","Start pose after being idle":"闲置多久后开始摆姿势","Store":"商店","Striker":"突击手","Study Room":"自习室","Style: <b>basic (no counter)</b>   ·   Counter: <font color=\"#E84658\">your style has no counter (Wing Chun / Aikido)</font>":"流派：<b>基础（无反击）</b>   ·   反击：<font color=\"#E84658\">当前流派没有反击（咏春／合气道）</font>","Swap your animation for another style's animation — <b>visible to other players</b>. Visual only: timing, range & damage stay your original style's. The style & move list is read live from the game, so new styles show up automatically.":"将你的动画替换为其他流派动画——<b>其他玩家可见</b>。仅改变视觉：时机、距离和伤害仍是原流派数值。流派与动作列表从游戏实时读取，新流派会自动显示。","Systema":"西斯特玛","TELEPORT":"传送","TEST KEY (1 SMALL REQUEST)":"测试密钥（1 次小请求）","THANKS":"感谢","THEME":"主题","TIMING & ACCURACY":"时机与精度","TRY CHATTING (NOT SENT TO CHAT)":"试聊（不发送到游戏聊天）","Taekwondo":"跆拳道","Taijutsu":"体术","Target Lock (Z)":"目标锁定（Z）","Target player":"目标玩家","Target player (Player mode)":"目标玩家（玩家模式）","Target:  (none)":"目标： （无）","Taunt emote":"嘲讽表情动作","The position sent to the server is shifted in front of the target only during the hitbox (~0.3s); on your screen your body stays still. Target is locked once per swing & highlighted (flashes gold on a hit). Other people see you flash forward when you hit.":"仅在命中判定期间（约 0.3 秒）将发送给服务器的位置移到目标前方；本地画面中角色保持原位。每次挥击锁定并高亮一个目标（命中时闪金色）。其他玩家会看到你在命中时向前闪现。","Timing Counter":"反击时机","Tracer / scope / hitmarker play on every reach swing while Reach is on. Nobody else sees or hears it.":"开启攻击延伸后，每次挥击都会播放弹道／瞄准镜／命中标记。其他玩家看不到也听不到。","Type distance (stud)":"输入距离（格）","Type like someone chatting to your NPC, then press Enter...":"模拟他人与 NPC 聊天，输入后按 Enter…","U":"U","ULTRA INSTINCT (AUTO DODGE)":"自在极意（自动闪避）","UNLOAD SCRIPT (TURNS OFF ALL FEATURES)":"卸载脚本（关闭全部功能）","UNLOCK":"解除锁定","Ultra Instinct (auto dodge)":"自在极意（自动闪避）","Ultra Instinct visuals (aura, white hair, lightning, sound)":"自在极意特效（气场、白发、闪电、音效）","Umadance":"Umadance","Unlimited (no range limit)":"无限制（无距离限制）","Unlimited zoom out (scroll out as far as you want)":"无限拉远镜头（可任意向外缩放）","V I S U A L":"视觉","VIOLET":"紫罗兰","VISUAL":"视觉","VOLLEYBALL":"排球","Volleyball Court":"排球场","Volleyball has no timing meter (unlike basketball). Receive is sent when the ball's path is about to enter your range (+ping). Spike: height/direction still follow your camera.\nAuto receive: 0":"排球没有时机条（与篮球不同）。当球的轨迹即将进入你的范围时发送接球指令（计入延迟）。扣球高度／方向仍跟随镜头。\n自动接球：0 次","Volleyball: auto direction":"排球：自动方向","Volleyball: auto receive":"排球：自动接球","Volleyball: max power":"排球：最大力度","Volume":"音量","W H I F F":"打空","W O R L D":"世界","WANTS TO BE FRIENDS":"想交朋友","WHAT'S CHECKED (EVIDENCE)":"检查项目（证据）","WHOEVER ATTACKS FIRST":"优先攻击者","WORLD":"世界","Walk":"行走","Walk combat":"战斗行走","When you perfect parry":"完美招架时","Whisk":"Whisk","Wing Chun":"咏春","Women's Restroom (2F)":"女洗手间（二楼）","Workshop":"工作室","Wrestling":"摔跤","Y":"Y","YES / WANTS TO":"是／愿意","YOUR HUD":"自身状态栏","YOUR STYLE HAS NO COUNTER":"当前流派没有反击","Yakiniku":"Yakiniku","Your HUD":"自身状态栏","Your Roblox friends are automatically allowed":"自动允许你的 Roblox 好友","Your character becomes an NPC: talks during fights (duel starts, gets hit, parry, combo, win / lose), replies to nearby chat (understands Indonesian / English chat + slang, replies in their language), challenged = fights back, asks for mercy = let go. Fighting uses Auto Fight above. When not fighting: wanders, looks around, approaches & chats with people (most noticeable when target mode is \"Whoever attacks first\"). This mode isn't saved, it's always off when the script loads.":"让角色像 NPC 一样行动：战斗时说话（决斗开始、受击、招架、连招、胜负），回复附近聊天（理解印尼语／英语及俚语，并用对方语言回复），受挑战则应战，求饶则放过。战斗使用上方“自动战斗”。非战斗时四处走动、张望、接近他人并聊天（目标模式为“优先攻击者”时最明显）。此模式不保存，脚本每次加载均默认关闭。","Z":"Z","ZZZN ONEMINE":"ZZZN ONEMINE","Zzzn · chat reply ON · final boss ON":"Zzzn · 聊天回复 开 · 最终首领 开","body faces the attacker when their attack is about to be parried":"敌人的攻击即将被招架时，角色面向攻击者","empty = your character's name":"留空 = 使用角色名字","no preset loaded yet":"尚未加载预设","paste API key (sk-...) then press Enter":"粘贴 API 密钥（sk-...）后按 Enter","username, username2 (comma separated)":"用户名, 用户名2（英文逗号分隔）","yuda = Yuda? just a lackey. | oh Yuda, GGM's lackey.":"yuda = Yuda？只是个跟班。 | 哦，Yuda，GGM 的跟班。","動":"动","探":"探","構":"构","機":"机","熊猫":"熊猫","界":"界","補":"辅","視":"视","設":"设","踊":"舞","遊":"游","録":"录","鍵":"键","闘":"斗"}}]]
-- END GENERATED CONFIG

local HttpService = game:GetService("HttpService")
local translations = HttpService:JSONDecode(EMBEDDED_JSON).translations
local hooked = setmetatable({}, { __mode = "k" })

local function hook(obj)
    if hooked[obj] then return end
    local property
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        property = "Text"
    elseif obj:IsA("TextBox") then
        -- 保留用户输入，只翻译输入框占位提示。
        property = "PlaceholderText"
    else
        return
    end
    hooked[obj] = true
    local applying = false
    local function apply()
        if applying then return end
        local text = obj[property]
        local translated = translations[text]
        if type(translated) == "string" and translated ~= "" and translated ~= text then
            applying = true
            obj[property] = translated
            applying = false
        end
    end
    apply()
    obj:GetPropertyChangedSignal(property):Connect(apply)
end

local playerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
local roots = { playerGui }
local ok, coreGui = pcall(function() return game:GetService("CoreGui") end)
if ok then roots[#roots + 1] = coreGui end
if type(gethui) == "function" then
    local success, hidden = pcall(gethui)
    if success and hidden then roots[#roots + 1] = hidden end
end
local seen = {}
for _, root in ipairs(roots) do
    if not seen[root] then
        seen[root] = true
        pcall(function()
            root.DescendantAdded:Connect(function(obj) task.defer(hook, obj) end)
        end)
    end
end

local drawingTexts = setmetatable({}, { __mode = "k" })
if type(Drawing) == "table" and type(Drawing.new) == "function" then
    local library = Drawing
    local original = library.new
    local function wrapped(kind, ...)
        local obj = original(kind, ...)
        if kind == "Text" then drawingTexts[obj] = true end
        return obj
    end
    local installed = pcall(function() library.new = wrapped end) and library.new == wrapped
    if not installed then
        local proxy = setmetatable({ new = wrapped }, { __index = library })
        pcall(function() Drawing = proxy end)
    end
end

task.spawn(function()
    while true do
        for obj in pairs(drawingTexts) do
            local success, text = pcall(function() return obj.Text end)
            if not success and type(getrenderproperty) == "function" then
                success, text = pcall(getrenderproperty, obj, "Text")
            end
            local translated = success and translations[text]
            if type(translated) == "string" and translated ~= "" and translated ~= text then
                local applied = pcall(function() obj.Text = translated end)
                if not applied and type(setrenderproperty) == "function" then
                    pcall(setrenderproperty, obj, "Text", translated)
                end
            end
        end
        task.wait(0.1)
    end
end)

local function fetch(url)
    assert(type(url) == "string" and url:match("^https://"), "请配置 HTTPS 脚本地址")
    local success, source = pcall(function() return game:HttpGet(url) end)
    if success and type(source) == "string" and #source > 0 then return source end
    local requestFn = request or http_request or (syn and syn.request)
    if type(requestFn) == "function" then
        local fetched, response = pcall(requestFn, { Url = url, Method = "GET" })
        if fetched and type(response) == "table" then
            local code = tonumber(response.StatusCode or response.Status)
            if code and code >= 200 and code < 300 and type(response.Body) == "string" and #response.Body > 0 then
                return response.Body
            end
        end
    end
    error("下载失败，请检查 URL、网络与执行器的 HTTP 支持")
end

local success, err = pcall(function()
    local source = fetch(SCRIPT_URL)
    assert(type(loadstring) == "function", "执行器缺少 loadstring")
    local fn, compileError = loadstring(source)
    assert(fn, compileError)
    fn()
end)
if not success then warn("[界面汉化] " .. tostring(err)) end
