local SCRIPT_URL = [[https://raw.githubusercontent.com/bentancorhhgh-hue/fps-boot1/refs/heads/main/FPS/BOOST/Fake-an-Egg/refs/heads/ZaltrixNova]]
local EMBEDDED_JSON = [[{"version":1,"script_url":"https://raw.githubusercontent.com/bentancorhhgh-hue/fps-boot1/refs/heads/main/FPS/BOOST/Fake-an-Egg/refs/heads/ZaltrixNova","translations":{"+ ADD":"＋ 添加","1. On your MAIN account run this FPSBoost.lua (the one with the GUI).":"1. 在主账号中运行带有图形界面的 FPSBoost.lua。","15 FPS when window loses focus":"窗口失去焦点时降至 15 帧","2. On each BOT account run the script copied above (it already has your username as Owner and, if you created the private channel, the channel too).":"2. 在每个分身账号中运行上方复制的脚本，其中已包含你的主账号用户名（Owner）；如已创建私有频道，也会包含频道信息。","3. All accounts must be in the SAME server.":"3. 所有账号必须位于同一服务器。","4. Public chat commands: type them in your main account's chat starting with a dot (.). Bots only obey the Owner, but the whole server sees the message.":"4. 公共聊天命令：在主账号聊天中输入以点号（.）开头的命令。分身只服从 Owner，但服务器中的所有人都能看到消息。","5. Private commands (recommended): above, in Private chat, tap CREATE CHANNEL, copy the bot script again and run it on each bot. Then type in the box (e.g. .farm rare) and tap SEND: only your bots receive it. With Private mode, the buttons in this tab also use the channel. Do not share the channel name.":"5. 私有命令（推荐）：在上方“私有聊天”中点击“创建频道”，重新复制分身脚本并在各分身运行。随后在输入框填写命令（例如 .farm rare）并点击“发送”，仅你的分身会收到。开启私有模式后，本页按钮也使用该频道。请勿分享频道名称。","6. No name = all accounts (.turbo). With a name = only that one (.Bot1 turbo). First letters are enough: .bot turbo":"6. 不带名称表示全部账号（.turbo）；带名称则只操作该账号（.Bot1 turbo）。也可输入名称前缀，例如 .bot turbo。","7. Bot farm: .farm (or .farm rare epic) buys eggs, brings them to the green zone and, when the base is full, opens the ready ones. .farm off stops it. The rarities are listed below.":"7. 分身刷蛋：.farm（或 .farm rare epic）购买鸡蛋并带到绿色区域，基地满后开启已就绪的蛋。.farm off 停止刷取。可选稀有度见下方。","8. PLAYER tab: the same for your own account (farm with button and rarity, players and fake-egg ESP, Anti-AFK, Anti-lag and go to base when buying). That tab does not open eggs.":"8. “玩家”页用于主账号，包括刷取按钮与稀有度、玩家与假蛋透视、防挂机、减少卡顿、购蛋后回基地。该页功能不会开启鸡蛋。","<font color=\"#00C878\"><b>.60</b></font>  FPS limit: just type the number (.144 .240 .max)":"<font color=\"#00C878\"><b>.60</b></font>  帧率上限：直接输入数字（.144 .240 .max）","<font color=\"#00C878\"><b>.Bot1 alias ana</b></font>  gives the bot the nickname ana; then use .ana turbo (.Bot1 alias off removes it). Easier in the BOT GO tab":"<font color=\"#00C878\"><b>.Bot1 alias ana</b></font>  将分身别名设为 ana，随后可用 .ana turbo 控制（.Bot1 alias off 移除别名）；在“分身控制”页操作更方便","<font color=\"#00C878\"><b>.Bot1 close</b></font>  closes that bot account's Roblox":"<font color=\"#00C878\"><b>.Bot1 close</b></font>  关闭该分身账号的 Roblox 客户端","<font color=\"#00C878\"><b>.Bot1 farm common</b></font>  only that bot":"<font color=\"#00C878\"><b>.Bot1 farm common</b></font>  仅该分身","<font color=\"#00C878\"><b>.Bot1 rejoin</b></font>  that account rejoins the server":"<font color=\"#00C878\"><b>.Bot1 rejoin</b></font>  该账号重新加入服务器","<font color=\"#00C878\"><b>.Bot1 tirabat Player123</b></font>  only that bot attacks":"<font color=\"#00C878\"><b>.Bot1 tirabat Player123</b></font>  仅该分身攻击","<font color=\"#00C878\"><b>.Bot1 turbo</b></font>  only that account (name, display name or UserId)":"<font color=\"#00C878\"><b>.Bot1 turbo</b></font>  仅指定账号（用户名、显示名称或用户 ID）","<font color=\"#00C878\"><b>.Bot1 untirabat</b></font>  only that bot stops attacking":"<font color=\"#00C878\"><b>.Bot1 untirabat</b></font>  仅该分身停止攻击","<font color=\"#00C878\"><b>.afk</b></font>  AFK mode (.afk off to exit)":"<font color=\"#00C878\"><b>.afk</b></font>  挂机模式（.afk off 退出）","<font color=\"#00C878\"><b>.afk</b></font>  AFK mode (60s no input: 3D off, 10 FPS)":"<font color=\"#00C878\"><b>.afk</b></font>  挂机模式（60 秒无操作后关闭 3D 渲染，限制为 10 帧）","<font color=\"#00C878\"><b>.anim2</b></font>  Freeze ALL other animations":"<font color=\"#00C878\"><b>.anim2</b></font>  暂停全部其他动画","<font color=\"#00C878\"><b>.anim</b></font>  Freeze other players' animations":"<font color=\"#00C878\"><b>.anim</b></font>  暂停其他玩家动画","<font color=\"#00C878\"><b>.bases2</b></font>  DETACH other bases (Parent=nil, reversible)":"<font color=\"#00C878\"><b>.bases2</b></font>  卸载其他基地（Parent=nil，可还原）","<font color=\"#00C878\"><b>.bases</b></font>  Hide other bases (your view only)":"<font color=\"#00C878\"><b>.bases</b></font>  隐藏其他基地（仅本地显示）","<font color=\"#00C878\"><b>.bench</b></font>  3s benchmark":"<font color=\"#00C878\"><b>.bench</b></font>  3 秒性能测试","<font color=\"#00C878\"><b>.bg</b></font>  15 FPS when window loses focus":"<font color=\"#00C878\"><b>.bg</b></font>  窗口失去焦点时降至 15 帧","<font color=\"#00C878\"><b>.bot turbo</b></font>  all accounts starting with 'bot' (min. 3 letters)":"<font color=\"#00C878\"><b>.bot turbo</b></font>  名称以 bot 开头的全部账号（前缀至少 3 个字符）","<font color=\"#00C878\"><b>.bot1,bot2 turbo</b></font>  several accounts at once":"<font color=\"#00C878\"><b>.bot1,bot2 turbo</b></font>  同时操作多个账号","<font color=\"#00C878\"><b>.chars</b></font>  Other players without clothes/accessories":"<font color=\"#00C878\"><b>.chars</b></font>  隐藏其他玩家服装／饰品","<font color=\"#00C878\"><b>.closeall</b></font>  closes ALL bot accounts (not your main)":"<font color=\"#00C878\"><b>.closeall</b></font>  关闭全部分身客户端，不关闭主账号","<font color=\"#00C878\"><b>.core</b></font>  Hide CoreGui (chat/list/backpack)":"<font color=\"#00C878\"><b>.core</b></font>  隐藏核心界面（聊天／玩家列表／背包）","<font color=\"#00C878\"><b>.cosm</b></font>  Mute visual events (weather/VFX)":"<font color=\"#00C878\"><b>.cosm</b></font>  屏蔽视觉事件（天气／特效）","<font color=\"#00C878\"><b>.cull 300</b></font>  culling with radius in studs (.cull off)":"<font color=\"#00C878\"><b>.cull 300</b></font>  按指定半径进行距离剔除，单位为格（.cull off 关闭）","<font color=\"#00C878\"><b>.cull</b></font>  Distance culling (see radius above)":"<font color=\"#00C878\"><b>.cull</b></font>  距离剔除（半径见上方）","<font color=\"#00C878\"><b>.decal</b></font>  Hide decals / textures (studs)":"<font color=\"#00C878\"><b>.decal</b></font>  隐藏贴花／纹理（凸点）","<font color=\"#00C878\"><b>.deco</b></font>  Hide animal shadows/signs (view only)":"<font color=\"#00C878\"><b>.deco</b></font>  隐藏动物阴影／标牌（仅本地显示）","<font color=\"#00C878\"><b>.egg2</b></font>  EggEvent: limit to 20/s (throttle)":"<font color=\"#00C878\"><b>.egg2</b></font>  EggEvent：限制为每秒 20 次","<font color=\"#00C878\"><b>.egg</b></font>  Mute EggEvent (hides egg animations)":"<font color=\"#00C878\"><b>.egg</b></font>  屏蔽 EggEvent（隐藏鸡蛋动画）","<font color=\"#00C878\"><b>.eggv</b></font>  Hide eggs/nests/poof in Workspace (view)":"<font color=\"#00C878\"><b>.eggv</b></font>  隐藏场景中的蛋／巢／烟雾效果（仅本地显示）","<font color=\"#00C878\"><b>.emit</b></font>  Stop Emit() particles (lifetime 0)":"<font color=\"#00C878\"><b>.emit</b></font>  停止 Emit() 粒子（寿命设为 0）","<font color=\"#00C878\"><b>.extreme</b></font>  turbo + invisible map, culling and more":"<font color=\"#00C878\"><b>.extreme</b></font>  加速优化＋隐藏地图、距离剔除及更多优化","<font color=\"#00C878\"><b>.fade</b></font>  Remove screen overlays/fades (Iris/flash)":"<font color=\"#00C878\"><b>.fade</b></font>  移除屏幕叠加／淡入淡出效果（光圈／闪光）","<font color=\"#00C878\"><b>.farm admin</b></font>  Admin (only spawns in public servers)":"<font color=\"#00C878\"><b>.farm admin</b></font>  管理员稀有度（仅公共服务器生成）","<font color=\"#00C878\"><b>.farm ancient</b></font>  Ancient (new rarity; the game renames Admin to Ancient)":"<font color=\"#00C878\"><b>.farm ancient</b></font>  远古（新稀有度；游戏将 Admin 改名为 Ancient）","<font color=\"#00C878\"><b>.farm celestial</b></font>  Celestial":"<font color=\"#00C878\"><b>.farm celestial</b></font>  天界","<font color=\"#00C878\"><b>.farm common</b></font>  Common":"<font color=\"#00C878\"><b>.farm common</b></font>  普通","<font color=\"#00C878\"><b>.farm divine</b></font>  Divine":"<font color=\"#00C878\"><b>.farm divine</b></font>  神圣","<font color=\"#00C878\"><b>.farm epic</b></font>  Epic":"<font color=\"#00C878\"><b>.farm epic</b></font>  史诗","<font color=\"#00C878\"><b>.farm exotic</b></font>  Exotic":"<font color=\"#00C878\"><b>.farm exotic</b></font>  异域","<font color=\"#00C878\"><b>.farm extinct</b></font>  Extinct (new rarity; the game renames Hacker to Extinct)":"<font color=\"#00C878\"><b>.farm extinct</b></font>  灭绝（新稀有度；游戏将 Hacker 改名为 Extinct）","<font color=\"#00C878\"><b>.farm hacker</b></font>  Hacker (only spawns in public servers)":"<font color=\"#00C878\"><b>.farm hacker</b></font>  黑客稀有度（仅公共服务器生成）","<font color=\"#00C878\"><b>.farm legendary</b></font>  Legendary":"<font color=\"#00C878\"><b>.farm legendary</b></font>  传说","<font color=\"#00C878\"><b>.farm mythic</b></font>  Mythic":"<font color=\"#00C878\"><b>.farm mythic</b></font>  神话","<font color=\"#00C878\"><b>.farm off</b></font>  stops the farm":"<font color=\"#00C878\"><b>.farm off</b></font>  停止刷蛋","<font color=\"#00C878\"><b>.farm rare epic</b></font>  only the rarities you type (you can list several)":"<font color=\"#00C878\"><b>.farm rare epic</b></font>  仅所输入的稀有度，可同时列出多个","<font color=\"#00C878\"><b>.farm rare</b></font>  Rare":"<font color=\"#00C878\"><b>.farm rare</b></font>  稀有","<font color=\"#00C878\"><b>.farm secret</b></font>  Secret":"<font color=\"#00C878\"><b>.farm secret</b></font>  秘密","<font color=\"#00C878\"><b>.farm uncommon</b></font>  Uncommon":"<font color=\"#00C878\"><b>.farm uncommon</b></font>  罕见","<font color=\"#00C878\"><b>.farm</b></font>  bots buy eggs (any rarity), bring them to the green zone and open ready ones when the base is full":"<font color=\"#00C878\"><b>.farm</b></font>  分身购买任意稀有度的蛋，带回绿色区域；基地满后开启已就绪的蛋","<font color=\"#00C878\"><b>.fps 60</b></font>  same as .60":"<font color=\"#00C878\"><b>.fps 60</b></font>  与 .60 相同","<font color=\"#00C878\"><b>.fx</b></font>  Remove particles / Trails / Beams":"<font color=\"#00C878\"><b>.fx</b></font>  移除粒子／拖尾／光束","<font color=\"#00C878\"><b>.fx</b></font>  turns ON one feature by id (.fx off turns it off)":"<font color=\"#00C878\"><b>.fx</b></font>  按 ID 开启一项功能（.fx off 关闭）","<font color=\"#00C878\"><b>.gc</b></font>  force GC and measure memory":"<font color=\"#00C878\"><b>.gc</b></font>  强制垃圾回收并测量内存","<font color=\"#00C878\"><b>.gone</b></font>  DELETE Leaderboards/AdminTunnel (irrev.)":"<font color=\"#00C878\"><b>.gone</b></font>  删除排行榜／管理员通道（不可恢复）","<font color=\"#00C878\"><b>.help</b></font>  short command list":"<font color=\"#00C878\"><b>.help</b></font>  简短命令列表","<font color=\"#00C878\"><b>.hl</b></font>  Turn off Highlights":"<font color=\"#00C878\"><b>.hl</b></font>  关闭高亮","<font color=\"#00C878\"><b>.hname</b></font>  Hide names/health over characters":"<font color=\"#00C878\"><b>.hname</b></font>  隐藏角色头顶名称／血条","<font color=\"#00C878\"><b>.invis</b></font>  Invisible map (parts not drawn)":"<font color=\"#00C878\"><b>.invis</b></font>  隐藏地图（不绘制部件）","<font color=\"#00C878\"><b>.lboard</b></font>  Hide Leaderboards/AdminTunnel (reversible)":"<font color=\"#00C878\"><b>.lboard</b></font>  隐藏排行榜／管理员通道（可还原）","<font color=\"#00C878\"><b>.light</b></font>  Turn off lights (Point/Spot/Surface)":"<font color=\"#00C878\"><b>.light</b></font>  关闭灯光（点光源／聚光灯／表面光）","<font color=\"#00C878\"><b>.lite</b></font>  Minimal lighting (shadows/post/fog)":"<font color=\"#00C878\"><b>.lite</b></font>  简化光照（阴影／后期／雾）","<font color=\"#00C878\"><b>.load</b></font>  load config":"<font color=\"#00C878\"><b>.load</b></font>  加载配置","<font color=\"#00C878\"><b>.mat</b></font>  Flat materials + no shadows":"<font color=\"#00C878\"><b>.mat</b></font>  简化材质并关闭阴影","<font color=\"#00C878\"><b>.mesh</b></font>  Low-fidelity meshes":"<font color=\"#00C878\"><b>.mesh</b></font>  低精度网格","<font color=\"#00C878\"><b>.mute</b></font>  Mute ALL audio (master volume 0)":"<font color=\"#00C878\"><b>.mute</b></font>  关闭全部声音（总音量设为 0）","<font color=\"#00C878\"><b>.nuke</b></font>  DESTROY fx/lights/decals (irreversible)":"<font color=\"#00C878\"><b>.nuke</b></font>  销毁特效／灯光／贴花（不可恢复）","<font color=\"#00C878\"><b>.on fx light</b></font>  several features at once (.off to disable, .toggle to flip)":"<font color=\"#00C878\"><b>.on fx light</b></font>  同时操作多项功能（.off 关闭，.toggle 切换）","<font color=\"#00C878\"><b>.others</b></font>  Hide other players (your view only)":"<font color=\"#00C878\"><b>.others</b></font>  隐藏其他玩家（仅本地显示）","<font color=\"#00C878\"><b>.panel</b></font>  Live stats panel (CPU/GPU/ping)":"<font color=\"#00C878\"><b>.panel</b></font>  实时状态面板（CPU／GPU／延迟）","<font color=\"#00C878\"><b>.purge2</b></font>  PURGE ALL Assets: fx/lights/decals (irrev.)":"<font color=\"#00C878\"><b>.purge2</b></font>  清除全部资源：特效／灯光／贴花（不可恢复）","<font color=\"#00C878\"><b>.purge</b></font>  PURGE Assets templates (frees RAM, irrev.)":"<font color=\"#00C878\"><b>.purge</b></font>  清除资源模板（释放内存，不可恢复）","<font color=\"#00C878\"><b>.qual</b></font>  Graphics quality level 1":"<font color=\"#00C878\"><b>.qual</b></font>  画质等级设为 1","<font color=\"#00C878\"><b>.r3d</b></font>  Turn off 3D rendering (black screen, AFK)":"<font color=\"#00C878\"><b>.r3d</b></font>  关闭 3D 渲染（黑屏挂机）","<font color=\"#00C878\"><b>.rejoinall</b></font>  all bots rejoin (they re-run themselves)":"<font color=\"#00C878\"><b>.rejoinall</b></font>  全部分身重新加入并自动重新执行脚本","<font color=\"#00C878\"><b>.restore</b></font>  turns everything off, game back to normal":"<font color=\"#00C878\"><b>.restore</b></font>  关闭全部功能，将游戏恢复正常","<font color=\"#00C878\"><b>.s .h</b></font>  = .status  .help":"<font color=\"#00C878\"><b>.s .h</b></font>  = .status  .help","<font color=\"#00C878\"><b>.save</b></font>  save config":"<font color=\"#00C878\"><b>.save</b></font>  保存配置","<font color=\"#00C878\"><b>.scr</b></font>  Disable decorative UI scripts":"<font color=\"#00C878\"><b>.scr</b></font>  禁用装饰性界面脚本","<font color=\"#00C878\"><b>.sfx</b></font>  No audio effects (reverb/EQ/echo)":"<font color=\"#00C878\"><b>.sfx</b></font>  关闭音频效果（混响／均衡器／回声）","<font color=\"#00C878\"><b>.sgui</b></font>  Hide map Billboard/SurfaceGui":"<font color=\"#00C878\"><b>.sgui</b></font>  隐藏地图悬浮标签／表面界面","<font color=\"#00C878\"><b>.snd</b></font>  Mute map sounds":"<font color=\"#00C878\"><b>.snd</b></font>  关闭地图声音","<font color=\"#00C878\"><b>.status</b></font>  the bot replies FPS / MB / active features":"<font color=\"#00C878\"><b>.status</b></font>  分身回复帧率／内存 MB／已启用功能","<font color=\"#00C878\"><b>.t .x .r</b></font>  = .turbo  .extreme  .restore":"<font color=\"#00C878\"><b>.t .x .r</b></font>  = .turbo  .extreme  .restore","<font color=\"#00C878\"><b>.tags</b></font>  Remove animated tags (Rainbow/Hacked/...)":"<font color=\"#00C878\"><b>.tags</b></font>  移除动态标签（彩虹／黑客等）","<font color=\"#00C878\"><b>.tirabat Player123</b></font>  bots follow that player and hit them with the Bat":"<font color=\"#00C878\"><b>.tirabat Player123</b></font>  分身跟随指定玩家，并用球棒攻击","<font color=\"#00C878\"><b>.turbo</b></font>  turns on almost everything (recommended)":"<font color=\"#00C878\"><b>.turbo</b></font>  开启几乎所有优化（推荐）","<font color=\"#00C878\"><b>.ui</b></font>  Flat UI (no UIStroke/UIGradient)":"<font color=\"#00C878\"><b>.ui</b></font>  简化界面（无描边／渐变）","<font color=\"#00C878\"><b>.untirabat Player123</b></font>  stops tirabat on that player":"<font color=\"#00C878\"><b>.untirabat Player123</b></font>  停止对该玩家执行 tirabat","<font color=\"#00C878\"><b>.untirabat</b></font>  stops tirabat on all bots":"<font color=\"#00C878\"><b>.untirabat</b></font>  全部分身停止 tirabat","<font color=\"#00C878\"><b>.vf</b></font>  Hide ViewportFrames (3D icons)":"<font color=\"#00C878\"><b>.vf</b></font>  隐藏三维图标（ViewportFrame）","ACTIONS":"操作","ADVANCED":"高级","AFK mode (60s no input: 3D off, 10 FPS)":"挂机模式（60 秒无操作后关闭 3D 渲染，限制为 10 帧）","AUTO: ON":"自动：开启","Admin":"管理员","Alias":"别名","All":"全部","All rarities":"全部稀有度","Ancient":"远古","Anti-AFK (prevents idle kick)":"防挂机（防止闲置踢出）","Anti-lag (limits EggEvent and silences VFX)":"减少卡顿（限制 EggEvent 并屏蔽视觉特效）","BASIC":"基础","BENCHMARK 3s (compare before/after)":"3 秒性能测试（比较优化前后）","BOT GO":"分身控制","Bot Go":"分身控制","Bot script (GitHub)":"分身脚本（GitHub）","Bot username (if not auto-detected)":"分身用户名（未自动检测到时填写）","Bots: 0  |  in server: 0  |  responding: 0":"分身：0｜服务器内：0｜响应中：0","Buys shop eggs (the rarities you pick above; none picked = all), takes them to your base's green zone and repeats. Ignores fake eggs (disguised players). If your base is full (0 free nests) it waits: opening ready eggs is up to you. Uses teleport; turn it off with the button.":"购买商店中所选稀有度的蛋（未选择表示全部），传送到基地绿色区域后重复。跳过玩家伪装的假蛋。基地满时（无空巢）等待，需你自行开启已就绪的蛋。使用传送，可通过按钮关闭。","CLOSE":"关闭","CLOSE BOTS":"关闭分身客户端","COPY BOT SCRIPT":"复制分身脚本","CREATE CHANNEL":"创建频道","Celestial":"天界","Close / Rejoin":"关闭／重新加入","Common":"普通","Config":"配置","Culling radius (studs)":"距离剔除半径（格）","DELETE":"删除","DELETE Leaderboards/AdminTunnel (irrev.)":"删除排行榜／管理员通道（不可恢复）","DESTROY fx/lights/decals (irreversible)":"销毁特效／灯光／贴花（不可恢复）","DETACH other bases (Parent=nil, reversible)":"卸载其他基地（Parent=nil，可还原）","DETECT BOTS":"检测分身","Default":"默认","Disable decorative UI scripts":"禁用装饰性界面脚本","Distance culling (see radius above)":"距离剔除（半径见上方）","Divine":"神圣","EN":"英语","ESP":"透视标记","EXTREME":"极限优化","Egg farm":"刷蛋","Egg farm (buy and take to the green zone)":"刷蛋（购买并带至绿色区域）","EggEvent: limit to 20/s (throttle)":"EggEvent：限制为每秒 20 次","Epic":"史诗","Events & tags":"事件与标签","Exotic":"异域","Extinct":"灭绝","Extras":"附加功能","FORCE GC + measure memory":"强制垃圾回收并测量内存","FPS BOOST":"帧率优化","FPS limit":"帧率上限","Fake eggs ESP (disguised players)":"假蛋透视（伪装成蛋的玩家）","Farm (bots only)":"刷蛋（仅分身）","Farm OFF (1 eggs)":"刷蛋已关闭（1 个蛋）","Farm ON: All":"刷蛋已开启：全部","Feature IDs":"功能 ID","Flat UI (no UIStroke/UIGradient)":"简化界面（无描边／渐变）","Flat materials + no shadows":"简化材质并关闭阴影","Freeze ALL other animations":"暂停全部其他动画","Freeze other players' animations":"暂停其他玩家动画","Graphics quality level 1":"画质等级设为 1","Hacker":"黑客","Hide CoreGui (chat/list/backpack)":"隐藏核心界面（聊天／玩家列表／背包）","Hide Leaderboards/AdminTunnel (reversible)":"隐藏排行榜／管理员通道（可还原）","Hide ViewportFrames (3D icons)":"隐藏三维图标（ViewportFrame）","Hide animal shadows/signs (view only)":"隐藏动物阴影／标牌（仅本地显示）","Hide decals / textures (studs)":"隐藏贴花／纹理（凸点）","Hide eggs/nests/poof in Workspace (view)":"隐藏场景中的蛋／巢／烟雾效果（仅本地显示）","Hide map Billboard/SurfaceGui":"隐藏地图悬浮标签／表面界面","Hide names/health over characters":"隐藏角色头顶名称／血条","Hide other bases (your view only)":"隐藏其他基地（仅本地显示）","Hide other players (your view only)":"隐藏其他玩家（仅本地显示）","Interface":"界面","Invisible map (parts not drawn)":"隐藏地图（不绘制部件）","LOAD":"加载","Legendary":"传说","Live stats panel (CPU/GPU/ping)":"实时状态面板（CPU／GPU／延迟）","Low-fidelity meshes":"低精度网格","MAX":"不限","Manual buy":"手动购买","Map & render":"地图与渲染","Measuring 3s...":"正在进行 3 秒测试……","Minimal lighting (shadows/post/fog)":"简化光照（阴影／后期／雾）","Mute ALL audio (master volume 0)":"关闭全部声音（总音量设为 0）","Mute EggEvent (hides egg animations)":"屏蔽 EggEvent（隐藏鸡蛋动画）","Mute map sounds":"关闭地图声音","Mute visual events (weather/VFX)":"屏蔽视觉事件（天气／特效）","Mythic":"神话","No audio effects (reverb/EQ/echo)":"关闭音频效果（混响／均衡器／回声）","No bots yet: tap DETECT BOTS or add one by username":"暂无分身：点击“检测分身”或按用户名添加","No channel: tap CREATE CHANNEL.":"尚无频道：点击“创建频道”。","Not automatic: you buy yourself and, as soon as the purchase is confirmed, it takes you to your base's green zone as fast as possible (if the server sends you back, it retries slower). Nothing else.":"并非自动购买：需你手动买蛋；确认购买后会尽快将你带至基地绿色区域。若被服务器送回，则减慢速度重试。不执行其他操作。","On buying an egg, go to the base":"购蛋后返回基地","Optimizations":"优化","Other players without clothes/accessories":"隐藏其他玩家服装／饰品","Owner (username or UserId)":"主账号（用户名或用户 ID）","PLAYER":"玩家","PURGE ALL Assets: fx/lights/decals (irrev.)":"清除全部资源：特效／灯光／贴花（不可恢复）","PURGE Assets templates (frees RAM, irrev.)":"清除资源模板（释放内存，不可恢复）","Pick an account":"选择账号","Players & animations":"玩家与动画","Players ESP (name and distance)":"玩家透视（名称与距离）","Presets":"预设","Private chat (channel)":"私有聊天（频道）","Private message to bots (e.g. .farm rare)":"发给分身的私有命令（例如 .farm rare）","Private mode: buttons send through the channel":"私有模式：按钮通过频道发送","Protection":"防护","REJOIN":"重新加入","REJOIN BOTS":"分身重新加入","REMOVE":"移除","RESET CHANNEL":"重置频道","RESTORE":"还原","RESTORE ADVANCED":"还原高级优化","RESTORE ALL":"全部还原","Rare":"稀有","Rarities for .farm":".farm 的稀有度","Rarity to buy":"要购买的稀有度","Ready.":"就绪。","Remove animated tags (Rainbow/Hacked/...)":"移除动态标签（彩虹／黑客等）","Remove particles / Trails / Beams":"移除粒子／拖尾／光束","Remove screen overlays/fades (Iris/flash)":"移除屏幕叠加／淡入淡出效果（光圈／闪光）","RightShift: hide/show  •  ⚠ = irreversible":"右 Shift：收起／展开 • ⚠ 表示不可恢复","SAVE":"保存","SEND":"发送","SYNC ALIASES":"同步别名","Secret":"秘密","Shortcuts":"快捷操作","Status":"状态","Stop Emit() particles (lifetime 0)":"停止 Emit() 粒子（寿命设为 0）","System":"系统","TURBO":"加速优化","TURBO ALL":"全部加速优化","TURBO: turns on everything except the invisible map. EXTREME: adds invisible map, culling and no EggEvent. RESTORE ALL: turns everything off.":"加速优化：开启除隐藏地图外的全部优化。极限优化：额外隐藏地图、启用距离剔除并屏蔽 EggEvent。全部还原：关闭所有功能。","Tap a bot in the list to control it":"点击列表中的分身以控制它","The basics":"基础说明","Tip: settings are saved in the workspace/FPSBoost/ folder (each bot in its own file) and reapplied when re-run. Tap a command in the list to copy it.":"提示：设置保存在 workspace/FPSBoost/ 文件夹中（每个分身独立文件），重新运行时自动应用。点击列表中的命令即可复制。","Tirabat (bots only)":"球棒追击（仅分身）","Turn off 3D rendering (black screen, AFK)":"关闭 3D 渲染（黑屏挂机）","Turn off Highlights":"关闭高亮","Turn off lights (Point/Spot/Surface)":"关闭灯光（点光源／聚光灯／表面光）","Tutorial":"教程","Type a dot + the id: .fx turns on, .fx off turns off. Tap one to copy it.":"输入点号加功能 ID：.fx 开启，.fx off 关闭。点击条目可复制。","Type here: only bots with your channel get the message.":"在此输入，仅加入你的频道的分身会收到消息。","Type your MAIN account (Owner) and copy the script. Paste and run it on each bot account.":"填写主账号（Owner）并复制脚本，再分别粘贴到每个分身账号运行。","Uncommon":"罕见","Username":"用户名","admin":"管理员","–":"–","▸":"▸","▾":"▾","● you":"● 你","⚠ Irreversible":"⚠ 不可恢复","✓":"✓"," Search feature...":" 搜索功能……"}}]]
-- END GENERATED CONFIG

local HttpService = game:GetService("HttpService")
local translations = HttpService:JSONDecode(EMBEDDED_JSON).translations
local hooked = setmetatable({}, { __mode = "k" })

local function hook(obj)
    if hooked[obj] then return end
    local property
    if obj:IsA("TextLabel") or obj:IsA("TextButton") then
        property = "Text"
    elseif obj:IsA("TextBox") then
        -- 保留用户输入，只翻译输入框占位提示。
        property = "PlaceholderText"
    else
        return
    end
    hooked[obj] = true
    local applying = false
    local function apply()
        if applying then return end
        local text = obj[property]
        local translated = translations[text]
        if type(translated) == "string" and translated ~= "" and translated ~= text then
            applying = true
            obj[property] = translated
            applying = false
        end
    end
    apply()
    obj:GetPropertyChangedSignal(property):Connect(apply)
end

local playerGui = game:GetService("Players").LocalPlayer:WaitForChild("PlayerGui")
local roots = { playerGui }
local ok, coreGui = pcall(function() return game:GetService("CoreGui") end)
if ok then roots[#roots + 1] = coreGui end
if type(gethui) == "function" then
    local success, hidden = pcall(gethui)
    if success and hidden then roots[#roots + 1] = hidden end
end
local seen = {}
for _, root in ipairs(roots) do
    if not seen[root] then
        seen[root] = true
        pcall(function()
            root.DescendantAdded:Connect(function(obj) task.defer(hook, obj) end)
        end)
    end
end

local drawingTexts = setmetatable({}, { __mode = "k" })
if type(Drawing) == "table" and type(Drawing.new) == "function" then
    local library = Drawing
    local original = library.new
    local function wrapped(kind, ...)
        local obj = original(kind, ...)
        if kind == "Text" then drawingTexts[obj] = true end
        return obj
    end
    local installed = pcall(function() library.new = wrapped end) and library.new == wrapped
    if not installed then
        local proxy = setmetatable({ new = wrapped }, { __index = library })
        pcall(function() Drawing = proxy end)
    end
end

task.spawn(function()
    while true do
        for obj in pairs(drawingTexts) do
            local success, text = pcall(function() return obj.Text end)
            if not success and type(getrenderproperty) == "function" then
                success, text = pcall(getrenderproperty, obj, "Text")
            end
            local translated = success and translations[text]
            if type(translated) == "string" and translated ~= "" and translated ~= text then
                local applied = pcall(function() obj.Text = translated end)
                if not applied and type(setrenderproperty) == "function" then
                    pcall(setrenderproperty, obj, "Text", translated)
                end
            end
        end
        task.wait(0.1)
    end
end)

local function fetch(url)
    assert(type(url) == "string" and url:match("^https://"), "请配置 HTTPS 脚本地址")
    local success, source = pcall(function() return game:HttpGet(url) end)
    if success and type(source) == "string" and #source > 0 then return source end
    local requestFn = request or http_request or (syn and syn.request)
    if type(requestFn) == "function" then
        local fetched, response = pcall(requestFn, { Url = url, Method = "GET" })
        if fetched and type(response) == "table" then
            local code = tonumber(response.StatusCode or response.Status)
            if code and code >= 200 and code < 300 and type(response.Body) == "string" and #response.Body > 0 then
                return response.Body
            end
        end
    end
    error("下载失败，请检查 URL、网络与执行器的 HTTP 支持")
end

local success, err = pcall(function()
    local source = fetch(SCRIPT_URL)
    assert(type(loadstring) == "function", "执行器缺少 loadstring")
    local fn, compileError = loadstring(source)
    assert(fn, compileError)
    fn()
end)
if not success then warn("[界面汉化] " .. tostring(err)) end
